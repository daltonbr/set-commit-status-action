{
  "compilerOptions": {
      "target": "es2019",
      "module": "CommonJS",
      // Pinned so the emit layout cannot shift. Without it tsc infers rootDir
      // from the inputs, and any file added outside src/ would relocate the
      // output to lib/src/, breaking the "main" entry that ncc bundles from.
      "rootDir": "./src",
      "noEmitOnError": true,
      "outDir": "./lib",
      "sourceMap": false,
      "declaration": false,
      "removeComments": true,
      "strict": true,
      "noUnusedLocals": true,
      "noUnusedParameters": false,
      "noFallthroughCasesInSwitch": true,
      "esModuleInterop": true,
      "resolveJsonModule": true,
      "typeRoots": [
          "./node_modules/@types/"
      ]
  },
  "compileOnSave": true,
  "include": ["src/**.ts"]
}
